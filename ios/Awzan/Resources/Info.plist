<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bundled faces. A name missing here registers nothing and the app
	     silently renders in a system fallback — AwzanApp.init asserts on it. -->
	<key>UIAppFonts</key>
	<array>
		<string>ScheherazadeNew-Regular.ttf</string>
		<string>Newsreader.ttf</string>
		<string>Newsreader-Italic.ttf</string>
	</array>
	<!-- The design draws a docked tab bar and product-spec D-08 says never a
	     floating pill, which is what iOS 26 draws by default. This keeps the
	     classic bar; iOS honours it only for apps built with the iOS 26 SDK. -->
	<key>UIDesignRequiresCompatibility</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>ground</string>
	</dict>
	<!-- English UI, Arabic content: the app is NOT right-to-left. RTL goes on
	     the Arabic views and the answer field, never on the whole app
	     (product-spec D-62). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
